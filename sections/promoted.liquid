<div class="container-5"><div class="promotion_list-layout">{% for collection in collections %}    <div li-for="collection in collections" class="promotion_list-item">
                                    {% if collection.metafields.collection.promoted %}    <div li-if="collection.metafields.collection.promoted">
    <div class="panel"><a aria-label="Shop this collection" li-object:href="collection.url" href="{{ collection.url }}" class="panel_media w-inline-block"><img class="panel_image" src="{{ collection.image | image_url: width: 1536 }}" alt="{{ collection.title }}" sizes="100vw" li-object:src="collection.image | image_url: width: 1536" loading="lazy" li-object:alt="collection.title" srcset="{{ 'clover-crane-hero-placeholder-p-500.jpg' | asset_url }} 500w, {{ 'clover-crane-hero-placeholder-p-800.jpg' | asset_url }} 800w, {{ 'clover-crane-hero-placeholder-p-1080.jpg' | asset_url }} 1080w, {{ 'clover-crane-hero-placeholder.jpg' | asset_url }} 1280w"></a><div class="panel_action-group"><a li-object:href="collection.url" href="{{ collection.url }}" class="button cc-color-gray cc-gray-soft cc-size-4 shadow-6 w-inline-block"><div>Shop <span li-object="collection.title">{{ collection.title }}</span></div></a></div></div>    </div>
{% endif %}
                        </div>
{% endfor %}<div class="hide w-embed"><style>
  .promotion_list-item:not(:has(.panel)) {
    display: none;
  }
</style></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Promoted",
    "class": "section",
    "presets": [
        {
            "name": "Promoted",
            "category": "Liquify",
            "blocks": []
        }
    ]
} {% endschema %}