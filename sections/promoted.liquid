<div class="container-5"><div class="promotion_list-layout" li-content-for-blocks="">
{% for block in section.blocks %}
{% case block.type %}
{% when '@app' %}
{% render block %}
{% when 'promoted-panel' %}
            <div li-block="Promoted Panel" class="promotion_list-item{% if block.settings.half_width %} is-half{% endif %}">
                    
                    <div class="panel"><a aria-label="Shop this collection" li-object:href="block.settings.collection.url" href="{{ block.settings.collection.url }}" class="panel_media w-inline-block"><img class="panel_image" src="{{ block.settings.collection.image | image_url: width: 1536 }}" alt="{{ block.settings.collection.title }}" sizes="(max-width: 1280px) 100vw, 1280px" li-object:src="block.settings.collection.image | image_url: width: 1536" loading="lazy" li-object:alt="block.settings.collection.title" srcset="{{ 'clover-crane-hero-placeholder-p-500.jpg' | asset_url }} 500w, {{ 'clover-crane-hero-placeholder-p-800.jpg' | asset_url }} 800w, {{ 'clover-crane-hero-placeholder-p-1080.jpg' | asset_url }} 1080w, {{ 'clover-crane-hero-placeholder.jpg' | asset_url }} 1280w"></a><div class="panel_action-group"><a li-object:href="block.settings.collection.url" href="{{ block.settings.collection.url }}" class="button cc-color-gray cc-gray-soft cc-size-4 shadow-6 w-inline-block"><div>Shop <span li-object="block.settings.collection.title">{{ block.settings.collection.title }}</span></div></a></div></div>
                </div>{% when 'collection-slider' %}
            <div li-block="Collection Slider" class="promotion_list-item{% if block.settings.half_width %} is-half{% endif %}">
                    
                    <h2 class="font-size-5 font-weight-500">
{{ block.settings.text_heading }}
</h2>
                    <div data-delay="4000" data-animation="slide" class="collection-slider w-slider" data-autoplay="false" data-easing="ease" data-hide-arrows="true" data-disable-swipe="false" data-autoplay-limit="0" data-nav-spacing="3" data-duration="500" data-infinite="true"><div class="collection-slider_mask w-slider-mask">{% for product in block.settings.collection_products.products limit: block.settings.collection_products_limit %}
<div class="collection-slider_slide w-slide">
    <a li-object:href="product.url" href="{{ product.url }}" class="card cc-style-link p-4 w-inline-block"><div class="card_body-wrap"><div class="card_media"><img li-object:src="product.featured_image | image_url: width: 800" li-object:alt="product.title" alt="{{ product.title }}" src="{{ product.featured_image | image_url: width: 800 }}" loading="lazy" class="card_image"></div><div class="w-layout-hflex card_body"><div class="card_text-group"><h3 li-object="product.title" class="card_title">{{ product.title }}</h3></div></div></div></a>
</div>
{% endfor %}</div><div class="collection-slider_arrow w-slider-arrow-left"><svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 18 18" width="100%" fill="none" class="icon-size-4"><g fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" stroke="currentColor"><polyline points="11.5 15.25 5.25 9 11.5 2.75"></polyline></g></svg></div><div class="collection-slider_arrow w-slider-arrow-right"><svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 18 18" width="100%" fill="none" class="icon-size-4"><g fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" stroke="currentColor"><polyline points="6.5 2.75 12.75 9 6.5 15.25"></polyline></g></svg></div><div class="hide w-slider-nav"></div></div>
                </div>{% endcase %}
{% endfor %}

    </div></div> {% schema %} {
    "tag": "section",
    "name": "Promoted",
    "class": "section",
    "blocks": [
        {
            "name": "Promoted Panel",
            "type": "promoted-panel",
            "settings": [
                {
                    "type": "header",
                    "content": "Panel"
                },
                {
                    "type": "collection",
                    "id": "collection",
                    "label": "Collection"
                },
                {
                    "type": "checkbox",
                    "id": "half_width",
                    "label": "Half width",
                    "default": false
                }
            ]
        },
        {
            "name": "Collection Slider",
            "type": "collection-slider",
            "settings": [
                {
                    "type": "header",
                    "content": "Slider"
                },
                {
                    "type": "checkbox",
                    "id": "half_width",
                    "label": "Half width",
                    "default": false
                },
                {
                    "id": "text_heading",
                    "type": "text",
                    "label": "Heading",
                    "default": "Gift Guides"
                },
                {
                    "id": "collection_products",
                    "type": "collection",
                    "label": "Products"
                },
                {
                    "type": "range",
                    "id": "collection_products_limit",
                    "min": 1,
                    "max": 99,
                    "step": 1,
                    "label": "Limit: Products",
                    "default": 6
                }
            ]
        },
        {
            "type": "@app"
        }
    ],
    "presets": [
        {
            "name": "Promoted",
            "category": "Liquify",
            "blocks": [
                {
                    "type": "promoted-panel"
                },
                {
                    "type": "collection-slider"
                }
            ]
        }
    ]
} {% endschema %}