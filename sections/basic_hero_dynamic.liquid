<div class="container-2">
          <div class="w-layout-vflex basic-hero_content">
            <h1 li-object="collection.title">{{ collection.title }}</h1>
            {% if collection.description != blank %}    <div li-if="collection.description != blank">
    
              <p li-object="collection.description">{{ collection.description }}</p>
                </div>
{% endif %}
          </div>
        </div>
        {% if collection.featured_image != blank %}    <div li-if="collection.featured_image != blank" class="basic-hero_media">
    <img src="{{ collection.featured_image | image_url: width: 1024 | placeholder: 'detailed-apparel-1' }}" loading="lazy" li-object:src="collection.featured_image | image_url: width: 1024 | placeholder: 'detailed-apparel-1'" li-object:alt="collection.featured_image.alt" alt="{{ collection.featured_image.alt }}" class="basic-hero_image">    </div>
{% endif %} {% schema %} {
    "tag": "section",
    "name": "Basic Hero (Dynamic)",
    "class": "section cc-basic-hero",
    "presets": [
        {
            "name": "Basic Hero (Dynamic)",
            "category": "Liquify",
            "blocks": []
        }
    ]
} {% endschema %}