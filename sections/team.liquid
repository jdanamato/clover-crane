<div class="container-4"><div class="home-cta_panel"><header data-wf--header--variant="column" class="section-header"><div class="section-header_content">{% for block in section.blocks %}
    {% if block.type == "kicker" %}
                    <div li-block="Kicker">
                                    <div class="kicker">
{{ block.settings.text_kicker }}
</div>
                            </div>
            {% endif %}
{% endfor %}{% for block in section.blocks %}
    {% if block.type == "headline" %}
                    <div li-block="Headline" class="section-header_title">
                                    <h2 class="display-size-1">
{{ block.settings.text_headline }}
</h2>
                            </div>
            {% endif %}
{% endfor %}</div></header><div class="home-cta_layout"><div class="home-cta_media"><div class="home-cta_image-wrap cc-joani">{% if section.settings.image_left_image %}
{{ section.settings.image_left_image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'home-cta_image' }}
{% else %}
 {{ 'image' | placeholder_svg_tag: 'home-cta_image' }} 
{% endif %}</div><div class="home-cta_image-wrap cc-kathi">{% if section.settings.image_right_image %}
{{ section.settings.image_right_image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'home-cta_image' }}
{% else %}
 {{ 'image' | placeholder_svg_tag: 'home-cta_image' }} 
{% endif %}</div></div><div class="home-cta_content"><p class="text-gray-1">
{{ section.settings.text_text }}
</p><div class="button-group"><a li-object:href="routes.contact_url" href="{{ section.settings.href_routescontact_url }}" class="button" href="#">
{{ section.settings.text_secondary_label }}
</a></div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Team",
    "class": "section bg-accent-2",
    "blocks": [
        {
            "name": "Kicker",
            "type": "kicker",
            "settings": [
                {
                    "id": "text_kicker",
                    "type": "text",
                    "label": "Kicker",
                    "default": "Kicker"
                }
            ]
        },
        {
            "name": "Headline",
            "type": "headline",
            "settings": [
                {
                    "id": "text_headline",
                    "type": "text",
                    "label": "Headline",
                    "default": "Section header"
                }
            ]
        }
    ],
    "settings": [
        {
            "id": "image_left_image",
            "type": "image_picker",
            "label": "Left Image"
        },
        {
            "id": "image_right_image",
            "type": "image_picker",
            "label": "Right Image"
        },
        {
            "id": "text_text",
            "type": "text",
            "label": "Text",
            "default": "At Clover and Crane, our passion is crafting unique experiences. Kathi and Joani are dedicated to bringing your visions to life with personalized products and exceptional service."
        },
        {
            "id": "href_routescontact_url",
            "type": "text",
            "label": "routes.contact_url"
        },
        {
            "id": "text_secondary_label",
            "type": "text",
            "label": "Secondary Label",
            "default": "Let's talk"
        }
    ],
    "presets": [
        {
            "name": "Team",
            "category": "Liquify",
            "blocks": [
                {
                    "type": "kicker"
                },
                {
                    "type": "headline"
                }
            ]
        }
    ]
} {% endschema %}