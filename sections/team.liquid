<div class="product-hero_container"><div class="home-cta_panel"><header data-wf--header--variant="column" class="section-header"><div class="section-header_content"><div class="kicker">
{{ section.settings.text_kicker }}
</div><h2 class="display-size-1">
{{ section.settings.text_headline }}
</h2></div></header><div class="home-cta_layout"><div class="home-cta_media"><div class="home-cta_image-wrap cc-joani">{% if section.settings.image_left_image %}
{{ section.settings.image_left_image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'home-cta_image' }}
{% else %}
 {{ 'image' | placeholder_svg_tag: 'home-cta_image' }} 
{% endif %}</div><div class="home-cta_image-wrap cc-kathi">{% if section.settings.image_right_image %}
{{ section.settings.image_right_image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'home-cta_image' }}
{% else %}
 {{ 'image' | placeholder_svg_tag: 'home-cta_image' }} 
{% endif %}</div></div><div class="home-cta_content"><p class="text-gray-1">
{{ section.settings.text_text }}
</p><div class="button-group"><a href="{{ section.settings.url_button_url }}" class="button"> {{ section.settings.text_button_label }} </a></div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Team",
    "class": "section bg-accent-2",
    "settings": [
        {
            "id": "text_kicker",
            "type": "text",
            "label": "Kicker",
            "default": "About Clover and Crane"
        },
        {
            "id": "text_headline",
            "type": "text",
            "label": "Headline",
            "default": "Meet Kathi &amp; Joani"
        },
        {
            "id": "image_left_image",
            "type": "image_picker",
            "label": "Left Image"
        },
        {
            "id": "image_right_image",
            "type": "image_picker",
            "label": "Right Image"
        },
        {
            "id": "text_text",
            "type": "text",
            "label": "Text",
            "default": "At Clover and Crane, our passion is crafting unique\n                  experiences. Kathi and Joani are dedicated to bringing your visions to life with personalized products\n                  and exceptional service."
        },
        {
            "id": "url_button_url",
            "type": "url",
            "label": "Button URL"
        },
        {
            "id": "text_button_label",
            "type": "text",
            "label": "Button Label",
            "default": "Let's talk"
        }
    ],
    "presets": [
        {
            "name": "Team",
            "category": "Liquify",
            "blocks": []
        }
    ]
} {% endschema %}