<div class="container-2">
          <div class="w-layout-vflex basic-hero_content">
            <h1>
{{ section.settings.text_page_title }}
</h1>
            {% if section.settings.page_description != blank %}    <div li-if="section.settings.page_description != blank">
    
              <p>
{{ section.settings.text_page_description }}
</p>
                </div>
{% endif %}
          </div>
        </div> {% schema %} {
    "tag": "section",
