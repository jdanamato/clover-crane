<div class="product-hero_container"><div class="footer_layout"><div class="footer_top"><div class="footer_top_column"><a aria-label="Back to Home" href="{{ routes.root_url }}" aria-current="page" class="brand-logo-link">{% if shop.brand.logo != blank %}<img width="500" alt="{{ shop.name }}" src="{{ shop.brand.logo | image_url: width: 500 }}" loading="lazy" class="brand-logo-image">{% else %}<div class="font-size-5 font-weight-600">{{ shop.name }}</div>{% endif %}</a></div><div li-for:inside="link in linklists['footer'].links" id="w-node-_71a3c63e-ee8c-740e-8e69-a04269f98962-69f9895e" class="footer_link-grid">
        {% for link in linklists['footer'].links %}                            <a li-object:href="link.url" li-object="link.title" href="{{ link.url }}" class="footer_link">{{ link.title }}</a>
                    {% endfor %}    </div></div><div role="separator" data-wf--divider--variant="gray-horizontal" class="divider"></div><div id="w-node-_71a3c63e-ee8c-740e-8e69-a04269f9896e-69f9895e" class="footer_bottom"><div class="footer_copyright"><div>
{{ section.settings.text_copyright }}
</div></div><div li-for:inside="link in linklists['legal'].links" id="w-node-_71a3c63e-ee8c-740e-8e69-a04269f98972-69f9895e" class="footer_legal-links">
        {% for link in linklists['legal'].links %}                            <a li-object="link.title" li-object:href="link.url" href="{{ link.url }}" class="footer_link">{{ link.title }}</a>
                    {% endfor %}    </div></div></div></div> <div id="cc-brand-probe" style="display:none">
P1[{{ shop.brand.slogan }}]P1
P2[{{ shop.brand.short_description }}]P2
P3[{{ shop.brand.social_links }}]P3
P5[{{ shop.brand.social_links.facebook }}]P5
P6[{{ shop.brand.metafields }}]P6
P7[{{ settings | json }}]P7
P8[{{ shop.brand.logo }}]P8
</div>
{% schema %}
{
  "tag": "footer",
  "name": "Footer",
  "class": "footer",
  "settings": [
    {
      "id": "text_copyright",
      "type": "text",
      "label": "Copyright",
      "default": "\u00a9 2026 Clover and Crane. All rights reserved."
    }
  ]
}
{% endschema %}