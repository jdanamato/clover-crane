{% paginate search.results by 50 %}
    <div li-paginate="search.results" li-paginate:by="50" class="container-5" by="50"><div class="search-headline"><h1 class="display-size-1">Search products</h1></div><div li-render-filter="wrapper" class="sidebar_layout"><div class="filter_sidebar"><div class="filter_layout"><div class="filter_header"><div class="font-size-4 font-weight-500">Filters</div><button li-render-filter="clear-all" type="button" class="filter_reset"><div class="pointer-events-none">Clear all</div></button></div><div class="filter_search-wrapper"><form action="/search" method="get"><input name="q" placeholder="Search" type="search" id="filter-search" li-object:value="search.terms" class="input" value="{{ search.terms }}"></form></div><div class="filter_results-wrapper"><div class="filter_results-text">Showing<span li-object="search.results_count" class="font-family-mono font-weight-500 mx-2">{{ search.results_count }}</span>products</div></div><div class="filter_scroll-wrapper"><div class="filter_filter-group-list">{% for filter in search.filters %}    <div li-for="filter in search.filters" class="filter_filter-group">
                                    {% if filter.values.size > 1 %}    <div li-if="filter.values.size > 1" class="filter_group-item">
    <div class="filter_header"><div li-object="filter.label" class="font-weight-500">{{ filter.label }}</div></div><div class="filter_list">{% for filter_value in filter.values %}    <div li-for="filter_value in filter.values" class="filter_item">
                                    <label class="filter_option"><div class="filter_option-inner"><input type="checkbox" x-on:change="checked = $event.target.checked" x-bind:class="{ 'w--redirected-checked': checked }" li-render-filter="filter" li-render-filter-value="{{ filter_value.value }}" li-render-filter-name="{{ filter_value.param_name }}" class="checkbox-input" x-data="{ checked: {{ filter_value.active }} }" id="filter-{{ filter.param_name | handleize }}-{{ filter_value.value | handleize }}"><span li-object="filter_value.label" class="filter_option-label" for="filter-{{ filter.param_name | handleize }}-{{ filter_value.value | handleize }}">{{ filter_value.label }}</span></div><div li-object="filter_value.count" class="filter_option-quantity">{{ filter_value.count }}</div></label>
                        </div>
{% endfor %}</div>    </div>
{% endif %}
                        </div>
{% endfor %}</div></div></div><a aria-label="Close filters" class="filter_modal-close-button"><svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 18 18" id="xmark" width="100%" class="icon-size-4"><g fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" stroke="currentColor"><line x1="14" y1="4" x2="4" y2="14"></line><line x1="4" y1="4" x2="14" y2="14"></line></g></svg></a></div><a class="filter_modal-trigger"><svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 18 18" width="100%" class="icon-size-3"><g fill="currentColor"><path d="M2.74999 2C2.46499 2 2.20499 2.161 2.07899 2.416C1.95199 2.671 1.98099 2.976 2.15299 3.203L7.00099 9.602V16.25C7.00099 16.515 7.14099 16.761 7.36899 16.896C7.48699 16.966 7.61899 17 7.75099 17C7.87599 17 7.99999 16.969 8.11199 16.907L10.612 15.532C10.852 15.4 11.001 15.148 11.001 14.875V9.602L15.848 3.203C16.02 2.976 16.049 2.671 15.922 2.416C15.796 2.161 15.535 2 15.251 2H2.74999Z" fill-opacity="0.4"></path></g></svg><div>Filters</div></a><div id="w-node-_26853262-2957-7a14-640e-6e1516cade83-70bd90f4" class="filter_results"><div class="filter_feed-header"><div class="filter_tags">{% for filter in search.filters %}    <div li-for="filter in search.filters" class="filter_tags_layout">
                                    {% for filter_value in filter.active_values %}    <div li-for="filter_value in filter.active_values" class="tag">
                                    <div li-object="filter_value.label">{{ filter_value.label }}</div>
                            <a li-render-filter-value="{{ filter_value.url_to_remove }}" aria-label="Remove filter" li-render-filter="filter-remove" href="#" class="tag_remove w-inline-block"><svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 18 18" aria-hidden="true" width="100%" fill="none" class="icon-size-1"><g fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor"><line x1="14" y1="4" x2="4" y2="14"></line><line x1="4" y1="4" x2="14" y2="14"></line></g></svg></a>
                        </div>
{% endfor %}
                        </div>
{% endfor %}</div><div li-render-filter="sort"><select id="sort-by" li-for:inside="option in search.sort_options" class="select">
        {% for option in search.sort_options %}                            <option li-object:value="option.value" li-object="option.name" class="select_option" value="{{ option.value }}">{{ option.name }}</option>
                    {% endfor %}    </select></div></div><div><div role="list" class="filter_product-list">{% for product in search.results %}    <div li-for="product in search.results" role="listitem" class="filter_product-list-item">
                                    {% render 'product_card', product: product %}
                        </div>
{% endfor %}</div>{% if search.results == blank %}    <div li-if="search.results == blank" class="empty-state w-dyn-empty">
    <div class="font-weight-500">No results found</div><div class="text-gray-1 font-size-2 margin-t-4">There are no results with this criteria. Try changing your search.</div>    </div>
{% endif %}</div>{% if paginate.pages > 1 %}    <div li-if="paginate.pages > 1">
    <nav aria-label="Pagination" class="filter_pagination"><ul role="list" class="filter_pagination_list w-list-unstyled"><li id="w-node-_82b45975-f6d5-157c-50e3-9c6959305b74-59305b72" class="filter_pagination_item"><div>{% if paginate.previous %}    <div li-if="paginate.previous" class="contents">
    <a li-object:href="paginate.previous.url" aria-label="Previous page" id="" class="pagination_button cc-is-previous" rel="prev" href="{{ paginate.previous.url }}"><svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 18 18" aria-hidden="true" width="100%" fill="none" class="icon-size-2"><g fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" stroke="currentColor"><polyline points="11.5 15.25 5.25 9 11.5 2.75"></polyline></g></svg><div>Previous</div></a>    </div>
{% endif %}</div>{% unless paginate.previous %}    <div li-unless="paginate.previous" aria-disabled="true" class="pagination_button cc-is-disabled cc-is-previous">
    <svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 18 18" aria-hidden="true" width="100%" fill="none" class="icon-size-2"><g fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" stroke="currentColor"><polyline points="11.5 15.25 5.25 9 11.5 2.75"></polyline></g></svg><div>Previous</div>    </div>
{% endunless %}</li>{% for part in paginate.parts %}    <li li-for="part in paginate.parts" id="w-node-_82b45975-f6d5-157c-50e3-9c6959305b82-59305b72" class="filter_pagination_item">
                                    {% if part.is_link == false %}    <div li-if="part.is_link == false" class="contents">
    <div aria-current="{% if part.title == paginate.current_page %}page{% endif %}"><div li-object="part.title" class="pagination_link is-current">{{ part.title }}</div></div>    </div>
{% endif %}
                            {% if part.is_link %}    <div li-if="part.is_link" class="contents">
    <a li-object:href="part.url" aria-label="Go to {{ part.title }}" href="{{ part.url }}"><div li-object="part.title" class="pagination_link">{{ part.title }}</div></a>    </div>
{% endif %}
                        </li>
{% endfor %}<li id="w-node-_82b45975-f6d5-157c-50e3-9c6959305b8a-59305b72" class="filter_pagination_item">{% unless paginate.next %}    <div aria-disabled="true" li-unless="paginate.next" class="pagination_button cc-is-disabled cc-is-next">
    <div>Next</div><svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 18 18" aria-hidden="true" width="100%" fill="none" class="icon-size-2"><g fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" stroke="currentColor"><polyline points="6.5 2.75 12.75 9 6.5 15.25"></polyline></g></svg>    </div>
{% endunless %}{% if paginate.next %}    <div li-if="paginate.next" class="contents">
    <a li-object:href="paginate.next.url" aria-label="Next page" class="pagination_button cc-is-next" rel="next" href="{{ paginate.next.url }}"><div>Next</div><svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 18 18" aria-hidden="true" width="100%" fill="none" class="icon-size-2"><g fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" stroke="currentColor"><polyline points="6.5 2.75 12.75 9 6.5 15.25"></polyline></g></svg></a>    </div>
{% endif %}</li></ul></nav>    </div>
{% endif %}</div></div></div>{% endpaginate %} {% schema %} {
    "tag": "section",
    "name": "Search",
    "class": "section",
    "presets": [
        {
            "name": "Search",
            "category": "Liquify",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "search"
        ]
    }
} {% endschema %}