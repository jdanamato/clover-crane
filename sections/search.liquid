<div class="container-5"><div class="search-headline"><div class="text-gray-1 font-size-4">Search results for</div><h1 class="search-headline_query"><span class="text-gray-1 font-size-6">"</span><span li-object="search.terms | escape ">{{ search.terms | escape  }}</span><span class="text-gray-1 font-size-6">"</span></h1></div><div li-render-filter="wrapper" class="sidebar_layout"><div id="w-node-a0642424-48ce-11a7-454f-437065c687a4-65c687a4" class="filter_sidebar"><div id="w-node-a0642424-48ce-11a7-454f-437065c687a6-65c687a4" class="filter_layout"><div class="filter_header"><div class="font-size-4 font-weight-500">Filters</div><button li-render-filter="clear-all" type="button" class="filter_reset"><div>Clear all</div></button></div><div class="filter_results-wrapper"><div class="filter_results-text">Showing <span li-object="search.results_count" class="font-family-mono font-weight-500">{{ search.results_count }}</span> products</div></div><div class="filter_scroll-wrapper"><div class="filter_filter-group-list">{% for filter in search.filters %}    <div li-for="filter in search.filters" class="filter_filter-group">
                                    {% if filter.values.size > 1 %}    <div li-if="filter.values.size > 1" class="filter_group-item">
    <div class="filter_header"><div li-object="filter.label" class="font-weight-500">{{ filter.label }}</div></div><div class="filter_list">{% for filter_value in filter.values %}    <div li-for="filter_value in filter.values" class="filter_item">
