<div class="container-3"><div class="flex flex-col gap-4">{% render 'section_header' %}<div li-render-recommended-path="{{ routes.product_recommendations_url }}" li-render-recommended="wrapper" li-render-recommended-product="{{ product.id }}" li-render-recommended-intent="related" li-render-recommended-limit="8" class="product_list-wrapper"><div li-render-recommended="target">{% assign rec_list = recommendations.products %}{% unless rec_list.size > 0 %}    <div li-unless="rec_list.size > 0">
    {% assign rec_list = product.collections.first.products %}    </div>
{% endunless %}<ul li-for:inside="p in rec_list limit: 8" role="list" class="product_list w-list-unstyled">
        {% for p in rec_list limit: 8 %}                            {% unless p.id == product.id %}    <li li-unless="p.id == product.id" class="product_list-item">
    {% render 'product_card', product: p %}    </li>
{% endunless %}
                    {% endfor %}    </ul></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Recommended Products",
    "class": "section",
    "blocks": [
        {
            "name": "Kicker",
            "type": "kicker",
            "settings": [
                {
                    "id": "text_kicker",
                    "type": "text",
                    "label": "Kicker",
                    "default": "Kicker"
                }
            ]
        },
        {
            "name": "Headline",
            "type": "headline",
            "settings": [
                {
                    "id": "text_headline",
                    "type": "text",
                    "label": "Headline",
                    "default": "Section header"
                }
            ]
        },
        {
            "name": "Body",
            "type": "body",
            "settings": [
                {
                    "id": "text_body",
                    "type": "text",
                    "label": "Body",
                    "default": "Add a short description for this section."
                }
            ]
        },
        {
            "name": "Button",
            "type": "button",
            "settings": [
                {
                    "id": "url_button_url",
                    "type": "url",
                    "label": "Button URL"
                },
                {
                    "id": "text_button_label",
                    "type": "text",
                    "label": "Button Label",
                    "default": "Button"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Recommended Products",
            "category": "Liquify",
            "blocks": [
                {
                    "type": "kicker"
                },
                {
                    "type": "headline"
                },
                {
                    "type": "body"
                },
                {
                    "type": "button"
                }
            ]
        }
    ],
    "enabled_on": {
        "templates": [
            "product"
        ]
    }
} {% endschema %}