{% endif %}<div class="product_add-to-cart">{% render 'quantity_adjust' %}<div class="hide w-embed w-script"><script>
                            document.addEventListener('click', function (e) {
  var btn = e.target.closest('[li-element="add-to-cart"]');
  if (!btn) return;
  var form = btn.closest('form');
  if (!form) return;
  var checkbox = form.querySelector('input[name="properties[_Add-Personalization]"]');
  if (!checkbox || !checkbox.checked) return;
  var variantEl = form.querySelector('[data-monogram-service-variant]');
  var variantId = variantEl && parseInt(variantEl.textContent, 10);
  if (!variantId) {
    console.warn('Monogramming Service Variant ID is not set in the Product Hero section settings &mdash; personalization upcharge was not added to cart.');
    return;
  }
  var properties = {};
  form.querySelectorAll('input[name^="properties["]').forEach(function (el) {
    if (el === checkbox) return;
    var name = el.name.replace(/^properties\[/, '').replace(/\]$/, '');
    if (el.type === 'radio') {
      if (el.checked) properties[name] = el.value;
    } else if (el.value) {
      properties[name] = el.value;
    }
  });
  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ items: [{ id: variantId, quantity: 1, properties: properties }] }),
  }).catch(function (err) {
    console.error('Failed to add monogramming service to cart', err);
  });
});
