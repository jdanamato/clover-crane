                                    <a li-object:href="article.url" href="{{ article.url }}" class="blog-post_card w-inline-block"><div id="w-node-_67666f6d-fc79-2518-3667-5695df60656a-df606569" class="blog-post_card_preview"><img id="w-node-_67666f6d-fc79-2518-3667-5695df60656b-df606569" li-object:src="article.image | image_url: width: 800" alt="{{ article.image.alt }}" src="{{ article.image | image_url: width: 800 }}" loading="lazy" li-object:alt="article.image.alt" class="blog-post_card_image"><div class="blog-post_card_overlay"></div></div><div class="blog-post_card_info"><div class="blog-post_card_tag-list">{% for tag in article.tags %}    <div li-for="tag in article.tags" class="tag">
                                    <div li-object="tag">{{ tag }}</div>
                        </div>
{% endfor %}</div><h2 li-object="article.title" class="blog-post_card_title">{{ article.title }}</h2></div></a>
                        </div>
{% endfor %}    </div>
{% endif %}{% if blog.articles == blank %}    <div li-if="blog.articles == blank" class="empty-state w-dyn-empty">
