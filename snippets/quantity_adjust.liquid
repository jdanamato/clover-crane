<div class="quantity-select_layout"><button type="button" aria-label="Decrease quantity" data-change="-1" class="quantity-select_button">-</button><input type="number" min="1" max="50" name="quantity" id="quantity-{{ section.id }}"{% if add_to_cart %} x-model.number="quantity"{% endif %} class="quantity-select_input" value="1"><button type="button" aria-label="Increase quantity" data-change="1" class="quantity-select_button">+</button></div><div class="hide w-embed w-script"><script>
                              document.addEventListener('click', (e) => {
  const btn = e.target.closest('[data-change]');
  if (!btn) return;
  const form = btn.closest('form');
  const input = form?.querySelector('input[name="quantity"]');
  if (!input) return;
  const delta = parseInt(btn.dataset.change, 10) || 0;
  const current = parseInt(input.value || '1', 10) || 1;
  const min = parseInt(input.getAttribute('min') || '1', 10);
  const max = parseInt(input.getAttribute('max') || '999', 10);
  const next = Math.max(min, Math.min(max, current + delta));
  input.value = next;
  // 'input' keeps Alpine's x-model in sync on the product page; 'change' is what the
  // cart page listens for.
  input.dispatchEvent(new Event('input', { bubbles: true }));
  input.dispatchEvent(new Event('change', { bubbles: true }));
});
                            </script></div>
