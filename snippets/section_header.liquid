<div class="section-header_content">{% for block in section.blocks %}
    {% if block.type == "kicker" %}
                    <div li-block="Kicker">
                                    <div class="kicker">
{{ block.settings.text_kicker }}
</div>
                            </div>
            {% endif %}
{% endfor %}{% for block in section.blocks %}
    {% if block.type == "headline" %}
                    <div li-block="Headline" class="section-header_title">
                                    <h2>
{{ block.settings.text_headline }}
</h2>
                            </div>
            {% endif %}
{% endfor %}{% for block in section.blocks %}
    {% if block.type == "body" %}
                    <div li-block="Body">
                                    <p class="text-gray-1">
{{ block.settings.text_body }}
</p>
                            </div>
            {% endif %}
{% endfor %}</div>{% for block in section.blocks %}
    {% if block.type == "button" %}
                    <div li-block="Button" class="button-group">
                                    <a href="{{ block.settings.url_button_url }}" class="button"> {{ block.settings.text_button_label }} </a>
                            </div>
            {% endif %}
{% endfor %}
