<div class="section-header_content">{% for block in section.blocks %}
    {% if block.type == "kicker" %}
                    <div li-block="Kicker">
                                    <div class="kicker">
{{ block.settings.text_kicker }}
</div>
                            </div>
            {% endif %}
{% endfor %}{% for block in section.blocks %}
    {% if block.type == "headline" %}
                    <div li-block="Headline" class="section-header_title">
                                    <h2>
{{ block.settings.text_headline }}
</h2>
                            </div>
            {% endif %}
{% endfor %}{% if Body %}    <div li-if="section.settings.body != blank" li-block="Body">
    <p class="text-gray-1">
{{ section.settings.text_body }}
</p>    </div>
{% endif %}</div>{% if Button %}    <div li-if="section.settings.button_url != blank and section.settings.button_label != blank" li-block="Button" class="button-group">
    <a href="{{ section.settings.url_button_url }}" class="button"> {{ section.settings.text_button_label }} </a>    </div>
{% endif %}
