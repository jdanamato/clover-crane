  }
  /* Prevent text size adjustment on mobile */
  html {
    -webkit-text-size-adjust: 100%;
  }
  /* Font rendering (optional - can make text too thin on some displays) */
  body {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }
  /* Disable tap highlight on interactive elements only */
  a,
  button,
  [role='button'],
  [onclick] {
    -webkit-tap-highlight-color: transparent;
  }
  video {
    display: inline-block;
    vertical-align: baseline;
    width: 100%;
    height: 100%;
  }
  /* Disable long-press callout on links/images (iOS) */
  a,
  img {
    -webkit-touch-callout: none;
  }
  /* Prevent image dragging */
  img {
    user-select: none;
    -webkit-user-drag: none;
  }
  ::selection {
    background: var(--gray--a5);
  }
  ::-moz-selection {
    background: var(--gray--a5); /* Should match ::selection */
  }
  /* Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--gray--7) var(--gray--1);
