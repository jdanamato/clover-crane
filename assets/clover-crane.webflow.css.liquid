@font-face {
  font-family: 'Inter';
  src: url({{ 'InterVariable.woff2' | asset_url }}) format('woff2');
  font-weight: 100 900;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'Inter Italic';
  src: url({{ 'InterVariable-Italic.woff2' | asset_url }}) format('woff2');
  font-weight: 100 900;
  font-style: italic;
  font-display: swap;
}

.accordion_body .rich-text-block {
  width: 90%;
}

.cart_property_list-item {
  font-size: var(--font-size-2);
}

.cart_property_list {
  padding-left: var(--space-3);
  padding-top: var(--space-2);
  padding-right: var(--space-3);
  padding-bottom: var(--space-2);
  flex: 0 0 auto;
  border-radius: var(--radius-small);
  border-style: dashed;
  border-width: var(--border-width-thin);
  border-color: var(--gray-6);
  background-color: var(--gray-1);
  max-width: none;
  width: max-content;
}

.cart_item_price {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: flex-end;
  gap: var(--gap-3);
}

.cart_item_preview {
  display: flex;
  flex-grow: 1;
  gap: var(--gap-3);
}

.mini-cart_thumbnail-wrap {
  aspect-ratio: 1;
  border: 1px solid var(--black-a2);
  border-radius: var(--radius-large);
  object-fit: cover;
  max-width: 6rem;
  height: 100%;
  max-height: 6rem;
  display: flex;
  overflow: hidden;
}

.mini-cart_thumbnail {
  border-radius: var(--radius-0);
  background-color: var(--gray-3);
  object-fit: cover;
  width: 100%;
  height: 100%;
}

.mini-cart_item_content {
  grid-column-gap: var(--gap-1);
  grid-row-gap: var(--gap-1);
  flex-flow: column;
  justify-content: flex-start;
  align-items: flex-start;
  display: flex;
  min-width: 0;
  flex-direction: column;
  width: auto;
  flex-grow: 1;
}

.swiper-button.swiper-prev {
  left: 0rem;
}

.swiper-button.swiper-next {
  right: 0rem;
}

.footer_top .brand-logo-image {
  width: auto;
}

.footer_top .brand-logo-link:first-child {
  width: max-content;
}