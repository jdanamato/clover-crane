.w-layout-vflex {
  flex-direction: column;
  align-items: flex-start;
  display: flex;
}

.w-layout-hflex {
  flex-direction: row;
  align-items: flex-start;
  display: flex;
}

.w-layout-grid {
  grid-row-gap: 16px;
  grid-column-gap: 16px;
  grid-template-rows: auto auto;
  grid-template-columns: 1fr 1fr;
  grid-auto-columns: 1fr;
  display: grid;
}

.w-layout-layout {
  grid-row-gap: 20px;
  grid-column-gap: 20px;
  grid-auto-columns: 1fr;
  justify-content: center;
  padding: 20px;
}

.w-layout-cell {
  flex-direction: column;
  justify-content: flex-start;
  align-items: flex-start;
  display: flex;
}

.w-checkbox {
  margin-bottom: 5px;
  padding-left: 20px;
  display: block;
}

.w-checkbox:before {
  content: " ";
  grid-area: 1 / 1 / 2 / 2;
  display: table;
}

.w-checkbox:after {
  content: " ";
  clear: both;
  grid-area: 1 / 1 / 2 / 2;
  display: table;
}

.w-checkbox-input {
  float: left;
  margin: 4px 0 0 -20px;
  line-height: normal;
}

.w-checkbox-input--inputType-custom {
  border: 1px solid #ccc;
  border-radius: 2px;
  width: 12px;
  height: 12px;
}

.w-checkbox-input--inputType-custom.w--redirected-checked {
  background-color: #3898ec;
  background-image: url(https://d3e54v103j8qbb.cloudfront.net/static/custom-checkbox-checkmark.589d534424.svg);
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: cover;
  border-color: #3898ec;
}

.w-checkbox-input--inputType-custom.w--redirected-focus {
  box-shadow: 0 0 3px 1px #3898ec;
}

.w-form-formradioinput--inputType-custom {
  border: 1px solid #ccc;
  border-radius: 50%;
  width: 12px;
  height: 12px;
}

.w-form-formradioinput--inputType-custom.w--redirected-focus {
  box-shadow: 0 0 3px 1px #3898ec;
}

.w-form-formradioinput--inputType-custom.w--redirected-checked {
  border-width: 4px;
  border-color: #3898ec;
}

body {
  background-color: var(--color-white);
  font-family: var(--font-sans);
  color: var(--color-gray-12);
  font-size: var(--font-size-3);
  line-height: var(--leading-4);
  cursor: default;
}

h1 {
  font-family: var(--font-display);
  font-size: var(--font-size-8);
  line-height: var(--leading-1);
  margin-top: 0;
  margin-bottom: 0;
}

h2 {
  font-family: var(--font-display);
  font-size: var(--font-size-7);
  line-height: var(--leading-2);
  margin-top: 0;
  margin-bottom: 0;
}

h3 {
  font-family: var(--font-display);
  font-size: var(--font-size-6);
  line-height: var(--leading-2);
  margin-top: 0;
  margin-bottom: 0;
}

h4 {
  font-family: var(--font-display);
  font-size: var(--font-size-5);
  line-height: var(--leading-3);
  margin-top: 0;
  margin-bottom: 0;
}

h5 {
  margin-top: var(--space-0);
  margin-bottom: var(--space-0);
  font-family: var(--font-display);
  font-size: var(--font-size-4);
  line-height: var(--leading-3);
}

h6 {
  margin-top: var(--space-0);
  margin-bottom: var(--space-0);
  font-family: var(--font-display);
  font-size: var(--font-size-3);
  line-height: var(--leading-3);
}

p {
  max-width: var(--container-3);
  cursor: default;
  margin-bottom: 0;
}

a {
  text-decoration: underline;
  -webkit-text-decoration-color: var(--color-gray-6);
  text-decoration-color: var(--color-gray-6);
  text-decoration-thickness: var(--border-theme);
  text-underline-position: under;
  cursor: pointer;
  color: inherit;
}

a:focus-visible,
a[data-wf-focus-visible] {
  outline-color: var(--color-accent-8);
  outline-offset: 1px;
  outline-width: 1px;
  outline-style: solid;
}

ul {
  width: 100%;
  margin-bottom: var(--space-0);
  padding-left: var(--space-9);
  grid-column-gap: var(--gap-1);
  grid-row-gap: var(--gap-1);
  flex-flow: column;
  display: flex;
}

ol {
  width: 100%;
  margin-bottom: var(--space-0);
  padding-left: var(--space-9);
  grid-column-gap: var(--gap-1);
  grid-row-gap: var(--gap-1);
  flex-flow: column;
  list-style-type: decimal;
  display: flex;
}

img {
  border-radius: var(--radius-lg);
  max-width: 100%;
  display: inline-block;
}

label {
  color: var(--color-gray-11);
  font-size: var(--font-size-2);
  font-weight: var(--font-weight-medium);
  margin-bottom: 0;
}

strong {
  font-weight: var(--font-weight-semi-bold);
}

em {
  font-style: italic;
}

code {
  border-top-style: solid;
  border-top-width: var(--border-thin);
  border-top-color: var(--color-gray-a3);
  border-right-style: solid;
  border-right-width: var(--border-thin);
  border-right-color: var(--color-gray-a3);
  border-bottom-style: solid;
  border-bottom-width: var(--border-thin);
  border-bottom-color: var(--color-gray-a3);
  border-left-style: solid;
  border-left-width: var(--border-thin);
  border-left-color: var(--color-gray-a3);
  border-top-left-radius: var(--radius-sm);
  border-top-right-radius: var(--radius-sm);
  border-bottom-left-radius: var(--radius-sm);
  border-bottom-right-radius: var(--radius-sm);
  background-color: var(--color-gray-3);
  font-family: var(--font-mono);
  color: var(--color-gray-11);
  white-space: pre-wrap;
  text-wrap: pretty;
  padding-bottom: .1em;
  padding-left: .25em;
  padding-right: .25em;
  font-size: .825em;
}

pre {
  border-radius: var(--radius-theme);
  width: 100%;
  font-size: var(--font-size-2);
}

blockquote {
  width: 100%;
  padding: var(--size-0);
  color: var(--color-gray-11);
  font-size: var(--font-size-5);
  line-height: var(--leading-4);
  border-left-style: none;
  margin-bottom: 0;
}

figure {
  margin-top: 1rem;
  margin-bottom: 1rem;
}

figcaption {
  margin-top: var(--space-2);
  color: var(--color-gray-11);
  font-size: var(--font-size-2);
  text-align: center;
}

.fs_selectcustom-1_dropdown {
  z-index: 99;
  margin-left: 0;
}

.accordion_summary {
  padding: var(--space-6) var(--space-8);
  grid-column-gap: var(--gap-4);
  grid-row-gap: var(--gap-4);
  background-color: var(--color-gray-3);
  cursor: pointer;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  display: flex;
}

.accordion_summary:hover {
  background-color: var(--color-gray-4);
}

.accordion_summary:active {
  background-color: var(--color-gray-5);
}

.accordion_summary:focus-visible,
.accordion_summary[data-wf-focus-visible] {
  outline-color: var(--color-accent-9);
  outline-offset: 4px;
  outline-width: 2px;
  outline-style: solid;
}

.accordion_summary.cc-style-ghost {
  background-color: var(--color-transparent);
}

.accordion_summary.cc-style-ghost:hover {
